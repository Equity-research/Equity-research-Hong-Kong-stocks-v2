[Unit]
Description=Stock FastAPI service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stock
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
